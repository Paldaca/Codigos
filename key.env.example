# Copia a key.env (mismo archivo que Portal-Paldaca y ActivosPALDACA).

DJANGO_SECRET_KEY=genera-una-clave-segura

SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_NAME=paldaca_sessionid
PALDACA_SSO_LOGIN_URL=http://localhost:5173/login/
PALDACA_SSO_LOGOUT_URL=http://localhost:8000/api/auth/sso/logout/

# Coolify / VPS: DATABASE_URL (dj-database-url). Tiene prioridad sobre MYSQL_*.
DATABASE_URL=mysql://usuario:clave@host-interno-coolify:3306/default

# Local: solo si DATABASE_URL está vacío.
MYSQL_DB=paldaca_db
MYSQL_USER=RAG
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Secreto PROPIO para firmar avisos al Portal (>= 32 caracteres). Mismo valor que
# PALDACA_NOTIF_SECRET_CODIGOS en el Portal. Vacio = esquema legado (derivado de
# DJANGO_SECRET_KEY). Ver Portal-Paldaca/docs/BUSINESS_RULES.md (RN-31).
#PALDACA_NOTIF_SECRET=
